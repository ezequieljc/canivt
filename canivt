_pairs = {}
_rich = True


def col(fg, bg=None):
    f = fg[0 if _rich else 1] if fg else -1
    b = bg[0 if _rich else 1] if bg else -1
    if (f, b) not in _pairs:
        n = len(_pairs) + 1
        if n >= curses.COLOR_PAIRS:
            return 0
        curses.init_pair(n, f, b)
        _pairs[f, b] = curses.color_pair(n)
    return _pairs[f, b]


