def ext_of(name):
    return os.path.splitext(name)[1].lower().lstrip('.')


def kind_of(name, is_dir, mode):
    if is_dir:
        return 'dir'
    e = ext_of(name)
    for k, s in (('music', AUDIO), ('image', IMAGE), ('video', VIDEO), ('archive', ARCHIVE), ('code', CODE)):
        if e in s:
            return k
    if e == 'pdf':
        return 'pdf'
    if e in TEXT or name.lower() in TEXT_NAMES:
        return 'text'
    if mode & 0o111:
        return 'exec'
    return 'file'


def looks_text(path):
    try:
        with open(path, 'rb') as f:
            b = f.read(8192)
    except OSError:
        return False
    if not b:
        return True
    if b'\0' in b:
        return False
    for cut in range(4):  # the block may end mid-character
        try:
            (b[:len(b) - cut] if cut else b).decode('utf-8')
            return True
        except UnicodeDecodeError:
            continue
    return False


def cw(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in 'WF' else 1


def swidth(s):
    return sum(cw(c) for c in s)


def clip(s, w):
    out, t = [], 0
    for c in s:
        x = cw(c)
        if t + x > w:
            break
        out.append(c)
        t += x
    return ''.join(out)


def safe(s):
    s = s.encode('utf-8', 'surrogateescape').decode('utf-8', 'replace')
    return ''.join(c if c.isprintable() or c == '\t' else '?' for c in s)


def put(scr, y, x, s, attr=0):
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x >= w:
        return
    s = clip(s, w - x)
    try:
        scr.addstr(y, x, s, attr)
    except curses.error:
        pass  # bottom-right cell: written, but curses still raises


def fill(scr, y, attr, x=0):
    h, w = scr.getmaxyx()
    put(scr, y, x, ' ' * (w - x), attr)


def hsize(n):
    for u in 'BKMGT':
        if n < 1024:
            return f'{n:.0f}{u}' if u == 'B' else f'{n:.1f}{u}'
        n /= 1024
    return f'{n:.1f}P'


