def save_lastdir(path):
    """Lets a shell function cd into the directory canivt was left in."""
    d = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'canivt')
    try:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, 'lastdir'), 'w') as f:
            f.write(path)
    except OSError:
        pass


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else '.'
    if arg in ('-h', '--help'):
        print(USAGE)
        return
    if arg in ('-v', '--version'):
        print(f'canivt {__version__}')
        return
    url = arg if arg.startswith('smb://') else None
    target = os.getcwd() if url else os.path.abspath(os.path.expanduser(arg))

    def run(scr):
        setup(scr)
        if os.path.isfile(target):
            app = App(scr, os.path.dirname(target))
            app.load(os.path.basename(target))
            app.open(app.cur)
        else:
            app = App(scr, target if os.path.isdir(target) else os.getcwd())
            if url:
                app.open_url(url)
        app.run()
        return app.cwd

    try:
        save_lastdir(curses.wrapper(run))
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
